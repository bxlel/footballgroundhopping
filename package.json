{
  "name": "spot-the-game",
  "version": "0.1.0",
  "description": "Trouve les matchs de football à voir autour de toi, où que tu voyages.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env node_modules/@angular/cli/bin/ng.js serve",
    "dev": "netlify dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr": "node --env-file-if-exists=.env scripts/serve-ssr.mjs",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "test:functions": "node --test \"tests/functions/*.test.mjs\"",
    "e2e": "npm run build && playwright test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run test:functions && npm run build",
    "sync": "node --env-file-if-exists=.env scripts/sync.mjs",
    "import:places": "node --env-file-if-exists=.env scripts/import-places.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "^20.3.35",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-server": "^20.3.35",
    "@angular/router": "^20.3.35",
    "@angular/ssr": "^20.3.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@primeuix/themes": "^3.1.1",
    "maplibre-gl": "^6.19.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.8",
    "@angular/cli": "^20.3.8",
    "@angular/compiler-cli": "^20.3.35",
    "@axe-core/playwright": "^4.14.1",
    "@netlify/angular-runtime": "^4.0.0",
    "@playwright/test": "^1.65.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "angular-eslint": "20.7.0",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4"
  }
}
